{
    "name": "@pelagica/i18n",
    "version": "1.0.0",
    "description": "Shared translations for Pelagica clients",
    "license": "GPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PelagicaApp/i18n.git"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./locales/*": "./locales/*",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "locales"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "generate": "node scripts/generate-resources.ts",
        "generate:fixtures": "node scripts/generate-plural-fixtures.ts",
        "validate": "node scripts/validate-locales.ts",
        "typecheck": "pnpm generate && tsc --noEmit",
        "build": "pnpm generate && tsup",
        "prepublishOnly": "pnpm validate && pnpm build"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    }
}
